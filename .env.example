# Copy to .env and fill in from Supabase: Project Settings -> API.
# Only the public anon / publishable key belongs here. It is safe in the app because
# every table is protected by Row Level Security.
# NEVER put the service_role key or an OpenAI key in this file or anywhere in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
